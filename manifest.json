{
  "manifest_version": 3,
  "name": "Google Chat Markdown Table",
  "version": "0.5.1",
  "description": "Render markdown tables inside Google Chat message bubbles.",
  "content_scripts": [
    {
      "matches": [
        "https://chat.google.com/*",
        "https://mail.google.com/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": [
        "src/tableParser.js",
        "src/textExtractor.js",
        "src/inlineMarkdown.js",
        "src/tableRenderer.js",
        "src/messageEnhancer.js",
        "src/tableWatcher.js",
        "src/htmlTable.js",
        "src/clipboardTable.js",
        "src/markdownTableWriter.js",
        "src/composerInserter.js",
        "src/pasteConverter.js",
        "src/tableModel.js",
        "src/tableEditor.js",
        "src/composerTableLocator.js",
        "src/codeBlockWriter.js",
        "src/composerPreview.js",
        "src/editorLauncher.js",
        "src/contentScript.js"
      ],
      "css": [
        "styles/mdtable.css"
      ]
    }
  ],
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "contextMenus"
  ],
  "background": {
    "service_worker": "src/background.js"
  }
}
